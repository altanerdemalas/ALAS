# --- Yapay zeka (araştırma + öğretme motoru) -------------------------------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (yüksek = daha derin araştırma, daha pahalı)
ANTHROPIC_EFFORT=high

# --- Printify -------------------------------------------------------------
# https://printify.com/app/account/api → Personal Access Token
PRINTIFY_API_TOKEN=
# /api/printify/status çağrısı mağaza listesini verir; ID'yi oradan al.
PRINTIFY_SHOP_ID=

# --- Profil (araştırmayı ve dersleri kişiselleştirir) ---------------------
SALES_CHANNELS=etsy,shopify,printify_popup
TARGET_MARKET=US
CONTENT_LANGUAGE=tr
STARTING_BUDGET=düşük (<$200)
EXPERIENCE_LEVEL=başlangıç

# --- Otomasyon ------------------------------------------------------------
# Her gün 07:00'de araştırma turu. Kapatmak için: off
RESEARCH_CRON=0 7 * * *
TOPICS_PER_RUN=2

PORT=3001
DB_FILE=./data/alas.db
