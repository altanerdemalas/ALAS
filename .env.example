# --- Yapay zeka (araştırma + öğretme motoru) -------------------------------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (yüksek = daha derin araştırma, daha pahalı)
ANTHROPIC_EFFORT=high

# --- Printify -------------------------------------------------------------
# https://printify.com/app/account/api → Personal Access Token
PRINTIFY_API_TOKEN=
# /api/printify/status çağrısı mağaza listesini verir; ID'yi oradan al.
PRINTIFY_SHOP_ID=

# --- Profil (araştırmayı ve dersleri kişiselleştirir) ---------------------
SALES_CHANNELS=etsy,shopify,printify_popup
TARGET_MARKET=US
CONTENT_LANGUAGE=tr
STARTING_BUDGET=düşük (<$200)
EXPERIENCE_LEVEL=başlangıç

# --- Otomasyon ve bütçe ---------------------------------------------------
# Otomatik araştırma varsayılan olarak KAPALI: bir tur ~$0.70 tutuyor,
# günlük tur ayda ~$40 demek. Panelden (Ayarlar) açabilirsin.
# Örnek: her gün 07:00 → 0 7 * * *   ·   haftada bir → 0 7 * * 1
RESEARCH_CRON=off
TOPICS_PER_RUN=1

# Aylık tahmini harcama sınırı. Aşılınca OTOMATİK turlar durur;
# elle çalıştırma engellenmez. 0 = sınırsız.
MONTHLY_BUDGET_USD=10

# ALAS açıldığında son tur bu saatten eskiyse kaçırılan tur telafi edilir.
CATCHUP_HOURS=20

PORT=3001
DB_FILE=./data/alas.db
